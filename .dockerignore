# Never ship real secrets or local state into the build context/image.
.env
.env.*
!.env.example
!.env.test.example

# Reinstalled fresh inside the image — the host's node_modules may contain
# native binaries built for the wrong OS/arch (Windows/macOS vs the
# node:20-alpine image), and copying it can silently shadow that step.
node_modules/

# Build output is produced inside the image by `npm run build`, not copied in.
dist/

# Not needed at build or runtime.
.git/
.github/
tests/
uploads/
*.log
logs/
coverage/
*.tsbuildinfo
.vscode/
.idea/
.DS_Store
Thumbs.db
