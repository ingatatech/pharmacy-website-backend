NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5435/ingata_pharmacy?schema=public"

# Placeholder only — generate a real secret for production, e.g.: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-string-in-production

# Restricts CORS to this origin only. If unset, the server falls back to
# http://localhost:3000 for local dev and logs a warning — set this
# explicitly before deploying anywhere real.
FRONTEND_URL=http://localhost:3000
