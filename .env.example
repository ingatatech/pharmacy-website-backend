NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5435/ingata_pharmacy?schema=public"

# Placeholder only — generate a real secret for production, e.g.: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-string-in-production

# Comma-separated list of origins allowed to call this API from a browser.
# Include the scheme, no trailing slash. A "*." entry allows any subdomain
# (use sparingly). In development http://localhost:3000 is allowed regardless;
# in production only what is listed here is trusted.
FRONTEND_URL=http://localhost:3000
# Example with several origins:
# FRONTEND_URL=https://pharmacy-website-frontend.vercel.app,https://admin.example.com

# Password used by the seed:admin script when creating the first admin account.
# Alternatively, omit it and the script will prompt for it (input hidden).
ADMIN_PASSWORD=

# The Swagger UI at /api-docs is served in development automatically. Set this
# to "true" to also expose it when NODE_ENV=production (e.g. so you can manage
# data through the API). The docs cover the full API, but the admin user
# management and audit-log endpoints are always hidden.
ENABLE_DOCS=
