NODE_ENV=test
PORT=4000

# Must point at a SEPARATE database from your dev DATABASE_URL — the test
# suite creates and deletes data freely. tests/global-setup.ts refuses to run
# migrations against a database whose name doesn't contain "test", as a
# safety net against pointing this at your real dev/prod database by mistake.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/ingata_pharmacy_test?schema=public"

JWT_SECRET=test-only-jwt-secret-do-not-use-in-real-environments
