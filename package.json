{
  "name": "ingata-pharmacy-backend",
  "version": "1.0.0",
  "description": "Backend API for Ingata Pharmacy",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc src/seed-admin.ts src/seed-data.ts src/seed-more-data.ts --outDir dist",
    "start": "node dist/seed-data.js && node dist/seed-more-data.js && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "ts-node src/seed-admin.ts",
    "seed:data": "ts-node src/seed-data.ts",
    "seed:more": "ts-node src/seed-more-data.ts",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/db/migrate-data-source.ts",
    "db:migrate:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/migrate-data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/migrate-data-source.ts",
    "db:verify": "ts-node scripts/verify-schema.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}